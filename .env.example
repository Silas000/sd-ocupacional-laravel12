APP_NAME="Sistema de Saúde Ocupacional"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# O CPF é cifrado com APP_KEY. Trocar a chave torna ilegíveis os CPFs
# já gravados — use `php artisan key:rotate` quando precisar rotacionar.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=saude_ocupacional
DB_USERNAME=root
DB_PASSWORD=

# Usado por `php artisan db:seed` para criar o administrador inicial.
# A senha é aplicada apenas na criação da conta e o administrador é
# obrigado a trocá-la no primeiro acesso.
ADMIN_EMAIL=admin@saude-ocupacional.com
ADMIN_PASSWORD=

# Banco separado usado pela suíte de testes. Precisa existir:
# CREATE DATABASE saude_ocupacional_test CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
DB_TEST_DATABASE=saude_ocupacional_test

SESSION_DRIVER=database
SESSION_LIFETIME=30
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="nao-responda@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
